# 表示する上流URL（nginx がプロキシする先）
KURUPIRO_UPSTREAM_URL="https://example.com/kurupiro"

# Chromium 内で通常表示するサイネージURL
KURUPIRO_KIOSK_URL="http://localhost/"

# Chromium で開く controller ページ
KURUPIRO_CONTROLLER_URL="http://localhost/controller.html"

# 表示に使う出力名（例: HDMI-1）
KURUPIRO_DISPLAY_OUTPUT="HDMI-1"

# 表示解像度（例: 1920x1080）
KURUPIRO_DISPLAY_MODE="1920x1080"

# リフレッシュレート（例: 60）
KURUPIRO_DISPLAY_RATE="60"

# 画面回転（normal / left / right / inverted）
KURUPIRO_DISPLAY_ROTATION="right"

# 自動シャットダウン時刻（HH:MM形式）
KURUPIRO_SHUTDOWN_TIME="21:57"

# 軽いリロードの間隔（systemd OnBootSec/OnUnitActiveSec 形式）
KURUPIRO_RELOAD_INTERVAL="2h"

# 通常サイネージを表示する時間
KURUPIRO_APP_SWITCH_INTERVAL="60s"

# 広告画像1枚ごとの表示時間
KURUPIRO_AD_IMAGE_DURATION="10s"

# Google Drive の公開フォルダURL（未設定なら Drive 画像同期は無効）
KURUPIRO_GOOGLE_DRIVE_FOLDER_URL=""

# Google Drive 画像同期の実行間隔（systemd timer 形式）
KURUPIRO_DRIVE_SYNC_INTERVAL="10min"
